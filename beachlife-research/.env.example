# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/beachlife

# ── Claude (review classification) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OTA listing + review data ─────────────────────────────────────────────────
# Which adapter supplies Airbnb/VRBO listing and review data.
#   airdna  — licensed AirDNA API (property-level listings + reviews)
#   csv     — manual CSV import (see docs/DATA_SOURCES.md for the column contract)
#   none    — skip OTA ingest entirely; run on public records + PM sites only
OTA_ADAPTER=none
AIRDNA_API_KEY=
AIRDNA_MARKET_ID=

# Key Data supplies AGGREGATE market benchmarks only — never competitor
# property-level rows. Used for the revenue-gap signal, not the roster.
KEYDATA_API_KEY=

# ── Public records ────────────────────────────────────────────────────────────
# Manatee County Property Appraiser CAMA bulk download (see docs/DATA_SOURCES.md)
MANATEE_CAMA_DIR=./data/cama

# ── Politeness ────────────────────────────────────────────────────────────────
CRAWL_USER_AGENT=BeachLifeResearch/0.1 (+contact: ops@beachlifevacations.com)
CRAWL_DELAY_MS=2000
